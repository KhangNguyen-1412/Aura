# ========================================================
# AURA PRODUCTION & GOOGLE DRIVE CLOUD CONFIGURATION
# ========================================================

PORT=3000
NODE_ENV=production

# Thư mục gốc Google Drive "Aura Media"
GDRIVE_ENABLED=true
GDRIVE_ROOT_FOLDER_ID=1Mz1kzYEAfx4oO1pKrj7hxZPOajS_QzHt

# Thông tin xác thực Google OAuth 2.0 (Cấu hình trên Render Environment Variables)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# URL callback sau khi đăng nhập (Đổi thành domain thật khi deploy lên mạng)
# Ví dụ: https://aura-media.onrender.com/api/drive/oauth2callback
GDRIVE_REDIRECT_URI=http://localhost:3000/api/drive/oauth2callback
